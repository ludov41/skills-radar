---
import Base from '../layouts/Base.astro';
import { getSkills, TOOLS } from '../lib/github';

const { skills, failedSearches } = await getSkills();

const compact = new Intl.NumberFormat('en', { notation: 'compact' });
const date = new Intl.DateTimeFormat('en', { dateStyle: 'medium' });
---

<Base title="Skills Radar">
  <header>
    <h1>Skills Radar</h1>
    <p>
      {skills.length > 0 ? `The ${skills.length} most starred` : 'The most starred'} agent skill repositories on GitHub.
      Updated {date.format(new Date())}.
    </p>
    {
      failedSearches.length > 0 && (
        <p class="notice">
          Some results are missing: {failedSearches.length} GitHub search(es) failed (rate limit or network error). Try
          again in a minute, or set <code>GITHUB_TOKEN</code>.
        </p>
      )
    }
    <div class="controls">
      <input id="filter" type="search" placeholder="Filter by name, owner or topic" aria-label="Filter skills" />
      <button id="filters-button" type="button" popovertarget="filters" aria-label="Filters" title="Filters">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 4h18l-7 8.5V19l-4 2v-8.5z"></path>
        </svg>
        <span id="filters-count" class="count" hidden></span>
      </button>
    </div>

    <form id="filters" popover>
      <fieldset>
        <legend>Found by</legend>
        <label><input type="checkbox" name="source" value="topic" checked /> Topic</label>
        <label><input type="checkbox" name="source" value="name" checked /> Repo name</label>
      </fieldset>
      <fieldset>
        <legend>Works with</legend>
        {
          Object.entries(TOOLS).map(([value, label]) => (
            <label>
              <input type="checkbox" name="tool" value={value} /> {label}
            </label>
          ))
        }
      </fieldset>
      <label class="select">
        <span>Updated</span>
        <select name="updated">
          <option value="">Any time</option>
          <option value="7">Past week</option>
          <option value="30">Past month</option>
          <option value="180">Past 6 months</option>
        </select>
      </label>
      <button type="reset">Reset filters</button>
    </form>
  </header>

  <ol id="list">
    {
      skills.map((skill, i) => (
        <li
          value={i + 1}
          data-search={`${skill.fullName} ${skill.description} ${skill.topics.join(' ')}`.toLowerCase()}
          data-sources={skill.sources.join(' ')}
          data-tools={skill.tools.join(' ')}
          data-pushed={Date.parse(skill.pushedAt)}
        >
          <div class="row">
            <a href={skill.url}>
              <span class="owner">{skill.owner}/</span>
              {skill.name}
            </a>
            <span class="stars" title={`${skill.stars.toLocaleString('en')} stars`}>
              ★ {compact.format(skill.stars)}
            </span>
          </div>
          {skill.description && <p>{skill.description}</p>}
          <small>Updated {date.format(new Date(skill.pushedAt))}</small>
        </li>
      ))
    }
  </ol>
  <p id="empty" hidden>No skills match your filters.</p>
</Base>

<script>
  const DAY = 24 * 60 * 60 * 1000;
  const ALL_SOURCES = ['topic', 'name'];

  const input = document.querySelector<HTMLInputElement>('#filter')!;
  const form = document.querySelector<HTMLFormElement>('#filters')!;
  const count = document.querySelector<HTMLElement>('#filters-count')!;
  const items = document.querySelectorAll<HTMLLIElement>('#list li');
  const empty = document.querySelector<HTMLElement>('#empty')!;

  const checked = (name: string) =>
    [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((box) => box.value);
  const select = form.querySelector<HTMLSelectElement>('select[name="updated"]')!;

  // Restore the view from the URL: ?q=text&source=topic&tool=claude,codex&updated=30
  function readUrl() {
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') ?? '';
    const sources = params.has('source') ? params.get('source')!.split(',') : ALL_SOURCES;
    const tools = params.get('tool')?.split(',') ?? [];
    for (const box of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
      box.checked = (box.name === 'source' ? sources : tools).includes(box.value);
    }
    select.value = params.get('updated') ?? '';
    if (select.selectedIndex === -1) select.value = '';
  }

  function apply() {
    const query = input.value.trim().toLowerCase();
    const sources = checked('source');
    const tools = checked('tool');
    const days = Number(select.value);
    const since = days ? Date.now() - days * DAY : 0;

    // OR within a group, AND between groups
    let shown = 0;
    for (const item of items) {
      const itemTools = item.dataset.tools!.split(' ');
      const match =
        item.dataset.search!.includes(query) &&
        item.dataset.sources!.split(' ').some((source) => sources.includes(source)) &&
        (tools.length === 0 || itemTools.some((tool) => tools.includes(tool))) &&
        Number(item.dataset.pushed) >= since;
      item.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;

    // Number of filters that differ from the defaults
    const active = ALL_SOURCES.length - sources.length + tools.length + (days ? 1 : 0);
    count.textContent = String(active);
    count.hidden = active === 0;

    // Only keep non-default values in the URL
    const params = new URLSearchParams();
    if (query) params.set('q', input.value.trim());
    if (sources.length < ALL_SOURCES.length) params.set('source', sources.join(','));
    if (tools.length) params.set('tool', tools.join(','));
    if (days) params.set('updated', String(days));
    const search = params.toString().replaceAll('%2C', ',');
    history.replaceState(null, '', search ? `?${search}` : location.pathname);
  }

  input.addEventListener('input', apply);
  form.addEventListener('change', apply);
  // Reset restores the default form values, then the change must be applied.
  form.addEventListener('reset', () => setTimeout(apply));

  readUrl();
  apply();
</script>

<style>
  header {
    padding-block: 2rem 1rem;
  }

  h1 {
    margin: 0;
  }

  header p,
  small,
  .owner {
    color: var(--muted);
  }

  .notice {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0.5rem;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
  }

  #filter,
  #filters-button,
  select {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  #filter {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.8rem;
  }

  #filters-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    cursor: pointer;
    anchor-name: --filters;
  }

  #filters-button:hover,
  #filters-button:focus-visible {
    border-color: var(--accent);
  }

  .count {
    position: absolute;
    top: -0.45rem;
    right: -0.45rem;
    min-width: 1.15rem;
    padding: 0 0.3rem;
    border-radius: 1rem;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.15rem;
  }

  /* Native popover; anchored below the funnel button where supported, centered otherwise */
  #filters {
    width: min(16rem, calc(100vw - 2rem));
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.15);
  }

  @supports (position-area: bottom) {
    #filters {
      position-anchor: --filters;
      position-area: bottom span-left;
      inset: auto;
      margin: 0.4rem 0 0;
    }
  }

  fieldset {
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
  }

  legend,
  .select span {
    margin-bottom: 0.25rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  #filters label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.15rem;
    cursor: pointer;
  }

  #filters input[type='checkbox'] {
    accent-color: var(--accent);
  }

  #filters .select {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  select {
    padding: 0.4rem 0.5rem;
    background: var(--bg);
  }

  button[type='reset'] {
    margin-top: 0.9rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  ol {
    padding-left: 2rem;
  }

  li {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  li::marker {
    color: var(--muted);
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .row a {
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .stars {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  li p {
    margin: 0.25rem 0;
  }
</style>
