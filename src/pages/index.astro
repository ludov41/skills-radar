---
import Base from '../layouts/Base.astro';
import { getSkills } from '../lib/github';

const skills = await getSkills();

const compact = new Intl.NumberFormat('en', { notation: 'compact' });
const date = new Intl.DateTimeFormat('en', { dateStyle: 'medium' });
---

<Base title="Skills Radar">
  <header>
    <h1>Skills Radar</h1>
    <p>
      The {skills.length} most starred agent skill repositories on GitHub. Updated
      {date.format(new Date())}.
    </p>
    <input id="filter" type="search" placeholder="Filter by name, owner or topic" aria-label="Filter skills" />
  </header>

  <ol id="list">
    {
      skills.map((skill, i) => (
        <li value={i + 1} data-search={`${skill.fullName} ${skill.description} ${skill.topics.join(' ')}`.toLowerCase()}>
          <div class="row">
            <a href={skill.url}>
              <span class="owner">{skill.owner}/</span>
              {skill.name}
            </a>
            <span class="stars" title={`${skill.stars.toLocaleString('en')} stars`}>
              ★ {compact.format(skill.stars)}
            </span>
          </div>
          {skill.description && <p>{skill.description}</p>}
          <small>Updated {date.format(new Date(skill.pushedAt))}</small>
        </li>
      ))
    }
  </ol>
  <p id="empty" hidden>No skills match your filter.</p>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('#filter')!;
  const items = document.querySelectorAll<HTMLLIElement>('#list li');
  const empty = document.querySelector<HTMLElement>('#empty')!;

  input.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let shown = 0;
    for (const item of items) {
      const match = item.dataset.search!.includes(query);
      item.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
  });
</script>

<style>
  header {
    padding-block: 2rem 1rem;
  }

  h1 {
    margin: 0;
  }

  header p,
  small,
  .owner {
    color: var(--muted);
  }

  input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  ol {
    padding-left: 2rem;
  }

  li {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  li::marker {
    color: var(--muted);
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .row a {
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .stars {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  li p {
    margin: 0.25rem 0;
  }
</style>
